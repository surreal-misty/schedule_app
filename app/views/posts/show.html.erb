<h1>スケジュール詳細</h1>

<p>タイトル：<%= @post.title %></p>
<p>開始日：<%= @post.start_date.strftime("%Y/%m/%d") %></p>
<p>終了日：<%= @post.end_date.strftime("%Y/%m/%d") %></p>
<p>終日：<%= "○" if @post.all_day %></p>
<p>内容：<%= @post.body %></p>
<p>更新日時：<%= @post.updated_at.strftime("%Y/%m/%d %H:%M") %></p>

<p>
  <%= link_to "編集", edit_post_path(@post) %>
  <%= link_to "一覧に戻る", posts_path %>
</p>